# ---------------------------------------------------------------------------
# SME single-pool deployment configuration.
#
#   cp .env.example .env   &&   edit .env   &&   docker compose \
#     -f docker-compose.production.yml up -d
#
# NEVER commit the filled-in .env — it holds live credentials. Only this
# .env.example (placeholders) belongs in git.
# ---------------------------------------------------------------------------

# === Public hostnames ======================================================
# Apex/console host and the S3 data-plane host. Both must have DNS A/AAAA
# records pointing at this VM's public IP before first boot, or the
# Let's Encrypt HTTP-01 challenge will fail. The S3 endpoint is published
# at s3.<DOMAIN_NAME>; the console at <DOMAIN_NAME> (and console.<DOMAIN_NAME>).
DOMAIN_NAME=example.com
LETSENCRYPT_EMAIL=ops@example.com

# === Wasabi (object storage backend) =======================================
# The only external dependency. Endpoint is region-specific; see
# https://docs.wasabi.com/docs/what-are-the-service-urls-for-wasabis-different-storage-regions
WASABI_ENDPOINT=s3.us-east-1.wasabisys.com
WASABI_REGION=us-east-1
WASABI_BUCKET=zkof-sme-prod
WASABI_ACCESS_KEY=your-wasabi-access-key
WASABI_SECRET_KEY=your-wasabi-secret-key

# === Customer Master Key (object encryption root) ==========================
# Pick ONE backend. The gateway resolves the CMK from KMS_CMK_URI:
#   * AWS KMS:        arn:aws:kms:us-east-1:111122223333:key/<id>   (set KMS_REGION)
#   * HashiCorp Vault Transit:  transit://my-key      (set VAULT_ADDR + VAULT_TOKEN)
#   * Local dev file: cmk://local/run/sme/secrets/cmk.key
# Leave the unused fields blank. For a true zero-dependency SME start you
# can use the local file backend, but a managed KMS/Vault is recommended
# for production key custody.
KMS_CMK_URI=
KMS_REGION=us-east-1
VAULT_ADDR=
VAULT_TOKEN=

# === Console admin =========================================================
# Bootstrap admin bearer token for the console API. Generate a long random
# value: `openssl rand -hex 32`.
ADMIN_TOKEN=change-me-openssl-rand-hex-32

# === Postgres (control plane) ==============================================
# POSTGRES_PASSWORD is the superuser password used only by the bootstrap
# job. ZKOF_APP_PASSWORD is the least-privilege role the gateway connects
# as at runtime (non-superuser, non-BYPASSRLS — required by the env=production
# RLS guard). Use two distinct strong values: `openssl rand -hex 24`.
# Either password may contain URL-reserved characters (@ : / ? # % …):
# the bootstrap passes them to psql as parameters and the gateway
# percent-encodes ZKOF_APP_PASSWORD into its DSN, so no escaping is needed.
POSTGRES_USER=postgres
POSTGRES_DB=zkof
POSTGRES_PASSWORD=change-me-postgres-superuser
ZKOF_APP_PASSWORD=change-me-zkof-app-role

# === ClickHouse (billing sink) =============================================
CLICKHOUSE_USER=zkof
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_DATABASE=zkof_billing

# === Cell identity =========================================================
# Logical cell name surfaced in health/quorum metadata. One pool = one cell.
ZKOF_CELL_ID=sme-cell-1

# === Image override (optional) =============================================
# Defaults to a locally built image. Point at a registry tag to pull a
# pre-built gateway instead of building on the VM.
# ZKOF_IMAGE=ghcr.io/kennguy3n/zk-object-fabric:latest
